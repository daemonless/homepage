#!/bin/sh
# Start homepage; /init has already dropped to the run user.

export HOME=/config
export PATH="/usr/local/bin:/usr/bin:/bin"
export PORT="${PORT:-3000}"
export HOMEPAGE_ALLOWED_HOSTS="${HOMEPAGE_ALLOWED_HOSTS:-*}"

# Determine app directory (check for actual app, not just /app existing)
if [ -f /app/server.js ]; then
    APP_DIR=/app
else
    APP_DIR=/usr/local/www/homepage
fi

cd "$APP_DIR"

# Both pkg and source builds have server.js
exec /usr/local/bin/node server.js
